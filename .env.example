# ─────────────────────────────────────────────────────────────
# Yukti Digital Solutions — Environment Variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# Database (MySQL) — used by Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://yukti:yukti_password@localhost:3306/yukti"

# Auth
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="yukti_token"

# App URLs (used for CORS + cookie config + canonical/SEO)
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"
PUBLIC_SITE_URL="http://localhost:5173"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880  # 5MB in bytes

# Email (SMTP) — optional; lead creation must never fail if email fails
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Yukti Digital Solutions <no-reply@yukti.example>"
MAIL_TO_INTERNAL="sales@yukti.example"

# Google Maps (public-safe key, restricted by referrer)
GOOGLE_MAPS_API_KEY=""

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100            # requests per window per IP

# Seed admin (used by `npm run db:seed`; change after first login)
SEED_ADMIN_EMAIL="admin@yukti.example"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Yukti Admin"
